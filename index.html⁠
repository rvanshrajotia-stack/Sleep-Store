      lucide.createIcons();
    }

    // Bundle Logic
    function toggleBundleItem(id) {
      const checkbox = document.getElementById(`chk-${id}`);
      checkbox.checked = !checkbox.checked;
      updateBundle();
    }

    function updateBundle() {
      const items = ['eye-mask', 'sunrise-clock', 'diffuser'];
      let selectedCount = 0;
      let origTotal = 0;

      items.forEach(id => {
        const chk = document.getElementById(`chk-${id}`);
        const card = document.getElementById(`bundle-card-${id}`);
        if (chk.checked) {
          selectedCount++;
          const prod = products.find(p => p.id === id);
          origTotal += prod.price;
          card.classList.add('border-accent-violet/80', 'bg-night-800');
          card.classList.remove('border-transparent', 'bg-night-900/50');
        } else {
          card.classList.remove('border-accent-violet/80', 'bg-night-800');
          card.classList.add('border-transparent', 'bg-night-900/50');
        }
      });

      let discountPercent = selectedCount >= 3 ? 0.30 : (selectedCount === 2 ? 0.15 : 0);
      let savings = origTotal * discountPercent;
      let finalPrice = origTotal - savings;

      document.getElementById('bundle-items-count').innerText = `${selectedCount} of 3`;
      document.getElementById('bundle-original-price').innerText = `$${origTotal.toFixed(2)}`;
      document.getElementById('bundle-savings').innerText = `-$${savings.toFixed(2)}`;
      document.getElementById('bundle-final-price').innerText = `$${finalPrice.toFixed(2)}`;
      document.getElementById('bundle-discount-badge').innerText = `Save ${(discountPercent * 100)}%`;
    }

    function addBundleToCart() {
      const items = ['eye-mask', 'sunrise-clock', 'diffuser'];
      let addedCount = 0;
      items.forEach(id => {
        const chk = document.getElementById(`chk-${id}`);
        if (chk.checked) {
          addToCart(id, false);
          addedCount++;
        }
      });
      if (addedCount > 0) {
        showToast(`Added ${addedCount} bundle items to your cart!`);
        toggleCart();
      } else {
        showToast('Please select at least 1 item for the bundle.');
      }
    }

    // Shopping Cart Functions
    function addToCart(productId, openDrawer = true) {
      const prod = products.find(p => p.id === productId);
      const existing = cart.find(item => item.id === productId);

      if (existing) {
        existing.qty += 1;
      } else {
        cart.push({ ...prod, qty: 1 });
      }

      updateCartUI();
      if (openDrawer) {
        showToast(`Added ${prod.name} to cart`);
        toggleCart();
      }
    }

    function updateCartQty(productId, delta) {
      const idx = cart.findIndex(item => item.id === productId);
      if (idx !== -1) {
        cart[idx].qty += delta;
        if (cart[idx].qty <= 0) {
          cart.splice(idx, 1);
        }
      }
      updateCartUI();
    }

    function updateCartUI() {
      const totalItems = cart.reduce((acc, item) => acc + item.qty, 0);
      const subtotal = cart.reduce((acc, item) => acc + (item.price * item.qty), 0);

      document.getElementById('cart-badge-count').innerText = totalItems;
      document.getElementById('drawer-cart-count').innerText = totalItems;
      document.getElementById('cart-subtotal').innerText = `$${subtotal.toFixed(2)}`;
      document.getElementById('cart-total').innerText = `$${subtotal.toFixed(2)}`;

      // Free shipping threshold ($100 target)
      const target = 100;
      const progress = Math.min((subtotal / target) * 100, 100);
      document.getElementById('shipping-progress').style.width = `${progress}%`;
      document.getElementById('shipping-bar-percent').innerText = `${Math.round(progress)}%`;

      if (subtotal >= target) {
        document.getElementById('shipping-bar-text').innerText = '🎉 You unlocked FREE Express Shipping!';
      } else {
        document.getElementById('shipping-bar-text').innerText = `Add $${(target - subtotal).toFixed(2)} more for FREE Express Shipping`;
      }

      // Render Drawer Items List
      const list = document.getElementById('cart-items-list');
      if (cart.length === 0) {
        list.innerHTML = `
          <div class="text-center py-12 text-slate-400 space-y-3">
            <i data-lucide="shopping-bag" class="w-12 h-12 mx-auto text-slate-600"></i>
            <p>Your cart is currently empty.</p>
          </div>
        `;
      } else {
        list.innerHTML = cart.map(item => `
          <div class="flex items-center gap-4 bg-night-800/80 p-3 rounded-xl border border-slate-800">
            <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover rounded-lg border border-slate-700" onerror="this.src='https://placehold.co/100/121629/FFFFFF?text=Item'">
            <div class="flex-1 min-w-0">
              <h4 class="text-white text-sm font-semibold truncate">${item.name}</h4>
              <p class="text-accent-gold text-xs font-bold mt-0.5">$${item.price}</p>
              <div class="flex items-center gap-3 mt-2">
                <div class="flex items-center border border-slate-700 rounded-lg overflow-hidden bg-night-900">
                  <button onclick="updateCartQty('${item.id}', -1)" class="px-2 py-0.5 text-slate-300 hover:bg-slate-700">-</button>
                  <span class="px-2 text-xs font-semibold text-white">${item.qty}</span>
                  <button onclick="updateCartQty('${item.id}', 1)" class="px-2 py-0.5 text-slate-300 hover:bg-slate-700">+</button>
                </div>
              </div>
            </div>
            <button onclick="updateCartQty('${item.id}', -${item.qty})" class="text-slate-500 hover:text-rose-400 p-1">
              <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
          </div>
        `).join('');
      }
      lucide.createIcons();
    }

    function toggleCart() {
      const drawer = document.getElementById('cart-drawer');
      const backdrop = document.getElementById('cart-drawer-backdrop');
      const isHidden = drawer.classList.contains('translate-x-full');

      if (isHidden) {
        backdrop.classList.remove('hidden');
        drawer.classList.remove('translate-x-full');
      } else {
        drawer.classList.add('translate-x-full');
        backdrop.classList.add('hidden');
      }
    }

    // Modal Quick View
    function openProductModal(productId) {
      const prod = products.find(p => p.id === productId);
      const modal = document.getElementById('product-modal');
      const backdrop = document.getElementById('product-modal-backdrop');
      const content = document.getElementById('modal-content');

      content.innerHTML = `
        <img src="${prod.image}" alt="${prod.name}" class="w-full h-64 object-cover rounded-xl border border-slate-700" onerror="this.src='https://placehold.co/600x400/121629/FFFFFF?text=${encodeURIComponent(prod.name)}'">
        <div class="space-y-4">
          <span class="bg-accent-violet/20 text-accent-violet text-xs font-bold px-2.5 py-1 rounded-full border border-accent-violet/30">${prod.badge}</span>
          <h3 class="font-serif text-2xl font-bold text-white">${prod.name}</h3>
          <p class="text-slate-300 text-sm leading-relaxed">${prod.desc}</p>
          <div class="flex items-baseline gap-3">
            <span class="text-3xl font-extrabold text-accent-gold">$${prod.price}</span>
            <span class="text-sm line-through text-slate-500">$${prod.originalPrice}</span>
          </div>
          <button onclick="addToCart('${prod.id}'); closeProductModal();" class="w-full py-3.5 rounded-xl bg-accent-violet hover:bg-accent-indigo text-white font-bold transition-colors flex items-center justify-center gap-2">
            <i data-lucide="shopping-bag" class="w-4 h-4"></i>
            <span>Add to Cart Now</span>
          </button>
        </div>
      `;

      backdrop.classList.remove('hidden');
      modal.classList.remove('hidden');
      lucide.createIcons();
    }

    function closeProductModal() {
      document.getElementById('product-modal').classList.add('hidden');
      document.getElementById('product-modal-backdrop').classList.add('hidden');
    }

    // FAQ Accordion Toggle
    function toggleFaq(id) {
      const ans = document.getElementById(`faq-ans-${id}`);
      const icon = document.getElementById(`faq-icon-${id}`);
      const isHidden = ans.classList.contains('hidden');

      if (isHidden) {
        ans.classList.remove('hidden');
        icon.classList.add('rotate-180');
      } else {
        ans.classList.add('hidden');
        icon.classList.remove('rotate-180');
      }
    }

    // Toast Notifications
    function showToast(message) {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'glass-card border border-accent-violet/50 text-white text-xs font-semibold px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2 animate-bounce pointer-events-auto';
      toast.innerHTML = `<i data-lucide="check-circle" class="w-4 h-4 text-emerald-400"></i><span>${message}</span>`;
      
      container.appendChild(toast);
      lucide.createIcons();

      setTimeout(() => {
        toast.remove();
      }, 3500);
    }

    // Checkout Simulation
    function checkout() {
      if (cart.length === 0) {
        showToast('Your cart is empty. Add items first!');
        return;
      }
      showToast('Redirecting to SSL Secure Express Checkout...');
    }
  </script>

</body>
</html>